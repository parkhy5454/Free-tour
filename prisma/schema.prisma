generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAVELER
  GUIDE
  ADMIN
}

enum RequestStatus {
  OPEN
  MATCHED
  CANCELLED
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TRAVELER)
  country      String?
  language     String   @default("ko")
  createdAt    DateTime @default(now())
  guideProfile GuideProfile?
  tripRequests TripRequest[] @relation("TravelerRequests")
  bookingsAsTraveler Booking[] @relation("TravelerBookings")
  reviews Review[]
  pickupRequests PickupRequest[] @relation("TravelerPickups")
  transfers      HotelTransfer[] @relation("TravelerTransfers")
  sentMessages   Message[] @relation("SentMessages")
  pointLedger PointLedger[]
  transferPartner TransferPartner?
}

model GuideProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline       String
  bio            String
  country        String
  city           String
  languages      String[]
  specialties    String[]
  hourlyRate     Int      @default(50000)
  currency       String   @default("KRW")
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  proposals      GuideProposal[]
  bookings       Booking[]
  experiences    Experience[]
}

// 가이드가 올리는 현지 체험 상품 (고정 가격, 예약 시 여행 요청·견적·예약을 자동 생성)
model Experience {
  id            String   @id @default(cuid())
  guideId       String
  guide         GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  title         String
  description   String
  country       String
  city          String
  category      String   @default("TOUR")
  durationHours Int
  price         Int
  currency      String   @default("KRW")
  maxPeople     Int      @default(4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  bookings      Booking[]
  @@index([country, city])
  @@index([guideId])
}

model TripRequest {
  id          String        @id @default(cuid())
  travelerId  String
  traveler    User          @relation("TravelerRequests", fields: [travelerId], references: [id], onDelete: Cascade)
  country     String
  city        String
  startDate   DateTime
  hours       Int
  partySize   Int           @default(1)
  interests   String[]
  details     String
  budget      Int?
  currency    String        @default("KRW")
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  proposals   GuideProposal[]
  booking     Booking?
}

model GuideProposal {
  id           String         @id @default(cuid())
  requestId    String
  guideId      String
  request      TripRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  guide        GuideProfile   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  price        Int
  currency     String         @default("KRW")
  message      String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  booking      Booking?
  @@unique([requestId, guideId])
}


model Booking {
  id             String        @id @default(cuid())
  requestId      String        @unique
  request        TripRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  travelerId     String
  traveler       User          @relation("TravelerBookings", fields: [travelerId], references: [id], onDelete: Restrict)
  guideId        String
  guide          GuideProfile  @relation(fields: [guideId], references: [id], onDelete: Restrict)
  proposalId     String        @unique
  proposal       GuideProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  amount         Int
  currency       String        @default("KRW")
  platformRate   Float         @default(0.18)
  platformFee    Int
  guidePayout    Int
  status         BookingStatus @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(CREATED)
  paymentProvider String?
  providerRef    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  review         Review?
  pickup         PickupRequest?
  transfers      HotelTransfer[]
  messages       Message[]
  sentIncidents  Incident[] @relation("SentIncidents")
  experienceId   String?
  cancelledAt    DateTime?
  incidents      Incident[]
  cancelledBy    String?
  refundAmount   Int           @default(0)
  experience     Experience?   @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  @@index([travelerId, createdAt])
  @@index([guideId, createdAt])
}

model PointLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  bookingId String?
  note      String?
  createdAt DateTime @default(now())
  @@unique([bookingId, reason])
  @@index([userId, createdAt])
}

model TransferPartner {
  id        String          @id @default(cuid())
  name      String
  country   String
  phone     String
  email     String?
  isActive  Boolean         @default(true)
  userId    String?         @unique
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessNumber String?
  licenseNumber  String?
  vehiclePlates  String[]   @default([])
  termsAgreedAt  DateTime?
  reportCount    Int        @default(0)
  createdAt DateTime        @default(now())
  pickups   PickupRequest[]
  transfers HotelTransfer[]
  @@index([country])
}

model PickupRequest {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId   String
  traveler     User          @relation("TravelerPickups", fields: [travelerId], references: [id], onDelete: Cascade)
  country      String
  airport      String
  flightNumber String
  arrivalAt    DateTime
  passengers   Int           @default(1)
  luggageCount Int           @default(0)
  pickupAddress String
  note         String?
  price        Int
  currency     String
  pointsUsed   Int           @default(0)
  status       PickupStatus  @default(REQUESTED)
  partnerId    String?
  partner      TransferPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  driverName   String?
  driverPhone  String?
  vehiclePlate String?
  vehicleSeats Int?
  acceptedAt   DateTime?
  reportedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([status, arrivalAt])
  @@index([partnerId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  rating    Int
  comment   String   @db.VarChar(1500)
  createdAt DateTime @default(now())
}

// 여행 중 호텔·장소 간 이동 (가이드 일정과 별도). 상태는 PickupStatus를 그대로 사용합니다.
model HotelTransfer {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId    String
  traveler      User          @relation("TravelerTransfers", fields: [travelerId], references: [id], onDelete: Cascade)
  country       String
  fromAddress   String
  toAddress     String
  rideAt        DateTime
  passengers    Int           @default(1)
  luggageCount  Int           @default(0)
  note          String?
  price         Int
  currency      String
  status        PickupStatus  @default(REQUESTED)
  partnerId     String?
  partner       TransferPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  driverName    String?
  driverPhone   String?
  vehiclePlate  String?
  vehicleSeats  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([status, rideAt])
  @@index([partnerId])
  @@index([bookingId])
}

// 예약 단위 채팅 메시지 (여행자와 배정된 가이드만 볼 수 있음)
model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@index([bookingId, createdAt])
}

// 여행자가 보낸 긴급 알림(SOS). 앱은 알림과 기록만 담당하며, 실제 대응은 사람이 합니다.
model Incident {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User     @relation("SentIncidents", fields: [reporterId], references: [id], onDelete: Cascade)
  type        String   @default("SOS")
  message     String?  @db.VarChar(500)
  status      String   @default("OPEN")
  adminNote   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  @@index([status, createdAt])
  @@index([bookingId])
}
